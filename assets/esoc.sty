\newcommand{\SheetStart}{\null\begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm,shift={(current page.south west)}]}
\newcommand{\SheetEnd}{\end{tikzpicture}\clearpage}
\newcommand{\Put}[5]{\node[anchor=north west,inner sep=0pt,text width=#3mm,align=left,font=\fontsize{#4}{\dimexpr#4pt+2pt\relax}\selectfont] at (#1,#2) {#5};}
\newcommand{\Head}[3]{%
 \node[anchor=north east,inner sep=0pt] at (195,284) {\includegraphics[height=17mm]{assets/esoc-logo.png}};
 \Put{15}{284}{153}{17}{\bfseries\color{ESOCGreen}#1}
 \Put{15}{274}{153}{11}{#2}
 \draw[ESOCRed,line width=.45mm] (15,265)--(195,265);
 \Put{15}{260}{180}{9}{#3}
}
\newcommand{\Foot}[2]{\draw[ESOCRule,line width=.2mm] (15,16)--(195,16);\Put{15}{13}{169}{7}{#1}\Put{189}{13}{6}{7}{#2}}
\newcommand{\Label}[3]{%
 \foreach \dx/\dy in {-.17/0,.17/0,0/-.17,0/.17,-.12/-.12,.12/.12,-.12/.12,.12/-.12} {
  \node[anchor=base west,inner sep=0pt,text=white,font=\fontsize{13}{13}\selectfont] at (#1+\dx,#2+\dy) {#3};}
 \node[anchor=base west,inner sep=0pt,text=CoursePurple,font=\fontsize{13}{13}\selectfont] at (#1,#2) {#3};
}
\newcommand{\Tick}[2]{\draw[ESOCGreen,line width=.25mm] (#1,#2) rectangle ++(3,3);}
